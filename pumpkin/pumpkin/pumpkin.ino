  ledcWrite(PIN_AUDIO, 0);
  ledcDetach(PIN_AUDIO);
  pinMode(PIN_AUDIO, OUTPUT);
  digitalWrite(PIN_AUDIO, LOW);
}

void openPlayClose() {
  // 1. Open
  myservo.write(SERVO_OPEN);
  delay(500);                // settle
  myservo.detach();          // cut holding current before audio

  // 2. Play
  playClip();

  // 3. Reattach and close
  myservo.attach(PIN_SERVO, 500, 2400);
  delay(50);
  myservo.write(SERVO_CLOSED);
  delay(500);
}

void setup() {
  Serial.begin(9600);

  myservo.setPeriodHertz(50);
  myservo.attach(PIN_SERVO, 500, 2400);

  pinMode(PIN_AUDIO, OUTPUT);
  digitalWrite(PIN_AUDIO, LOW);

  pinMode(R1, OUTPUT); pinMode(B1, OUTPUT); pinMode(G1, OUTPUT);
  pinMode(R2, OUTPUT); pinMode(B2, OUTPUT); pinMode(G2, OUTPUT);

  setColor(255, 0, 0);
  myservo.write(SERVO_CLOSED);
  Serial.println("Ready. Send START to run sequence, or a number 0-180 to move the servo.");
}

