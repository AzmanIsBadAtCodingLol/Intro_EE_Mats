      Serial.println("START received.");
      setColor(0, 255, 0);
      openPlayClose();
      setColor(255, 0, 0);
      Serial.println("Done.");
    } else if (cmd.length() > 0) {
      int angle = cmd.toInt();
      angle = constrain(angle, 0, 180);
      // Reattach if we detached earlier
      if (!myservo.attached()) {
        myservo.attach(PIN_SERVO, 500, 2400);
      }
      myservo.write(angle);
      Serial.print("Moved to: ");
      Serial.println(angle);
    }
  }
}