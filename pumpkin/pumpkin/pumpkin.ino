Servo myservo;

void setColor(int r, int g, int b) {
  analogWrite(R1, r); analogWrite(G1, g); analogWrite(B1, b);
  analogWrite(R2, r); analogWrite(G2, g); analogWrite(B2, b);
}

void playClip() {
  ledcAttach(PIN_AUDIO, CARRIER_HZ, 8);

  for (size_t i = 0; i < soundLen; i++) {
    ledcWrite(PIN_AUDIO, pgm_read_byte(&soundData[i]));
    delayMicroseconds(125);
